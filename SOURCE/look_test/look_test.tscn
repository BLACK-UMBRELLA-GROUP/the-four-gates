[sub_resource type="Shader" id="GroundShader"]
code = "shader_type spatial;\nrender_mode diffuse_burley;\nfloat hash(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453);}\nvarying vec3 world_position;\nvoid vertex(){world_position=(MODEL_MATRIX*vec4(VERTEX,1.0)).xyz;}\nvoid fragment(){float n=hash(floor(world_position.xz*15.0)); float broad=sin(world_position.x*1.32+sin(world_position.z*0.97))*sin(world_position.z*1.29); ALBEDO=vec3(0.48,0.355,0.215)*(0.96+n*0.08+broad*0.035); ROUGHNESS=0.95;}\n"

[sub_resource type="ShaderMaterial" id="GroundMaterial"]
shader = SubResource("GroundShader")

[sub_resource type="Shader" id="WaterShader"]
code = "shader_type spatial;\nrender_mode diffuse_burley, cull_disabled;\nuniform vec4 water_color : source_color = vec4(0.055, 0.23, 0.23, 1.0);\nvarying vec3 world_position;\nvoid vertex(){world_position=(MODEL_MATRIX*vec4(VERTEX,1.0)).xyz;}\nvoid fragment(){ vec2 p=world_position.xz*vec2(4.4,1.4167); float a=sin(p.y*2.2+sin(p.x*3.0)+TIME*0.8); float b=sin(p.y*4.0-p.x*2.1-TIME*0.6); ALBEDO=water_color.rgb*(0.90+0.09*a+0.04*b); ROUGHNESS=0.21; METALLIC=0.42; NORMAL_MAP=vec3(0.5+0.045*a,0.5+0.035*b,1.0); NORMAL_MAP_DEPTH=0.35; }\n"

