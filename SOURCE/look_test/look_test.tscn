[sub_resource type="Shader" id="SkyShader"]
code = "shader_type sky;\nuniform float phase : hint_range(0.0, 1.0) = 0.0;\nfloat hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }\nfloat noise(vec2 p) { vec2 i=floor(p); vec2 f=fract(p); f=f*f*(3.0-2.0*f); return mix(mix(hash(i),hash(i+vec2(1,0)),f.x),mix(hash(i+vec2(0,1)),hash(i+vec2(1,1)),f.x),f.y); }\nvoid sky() {\n vec3 d=normalize(EYEDIR); float h=clamp(d.y,0.0,1.0);\n float n=smoothstep(0.55,0.95,phase); float dusk=1.0-abs(phase*2.0-1.0);\n vec3 horizon=mix(vec3(0.76,0.67,0.51),vec3(0.038,0.065,0.125),n);\n horizon=mix(horizon,vec3(0.48,0.25,0.23),dusk*0.62);\n vec3 zenith=mix(vec3(0.23,0.43,0.58),vec3(0.008,0.018,0.058),n);\n vec3 c=mix(horizon,zenith,pow(h,0.42));\n vec2 uv=d.xz/max(d.y+0.32,0.06)*1.5;\n float clouds=noise(uv*1.4)*0.55+noise(uv*3.1)*0.28+noise(uv*6.2)*0.17;\n float cloud=smoothstep(0.50,0.72,clouds)*smoothstep(0.02,0.15,h)*(1.0-smoothstep(0.58,0.94,h));\n c=mix(c,mix(vec3(0.95,0.86,0.69),vec3(0.095,0.12,0.19),n),cloud*0.76);\n vec2 suv=vec2(atan(d.x,d.z),asin(d.y))*190.0; vec2 cell=floor(suv); vec2 f=fract(suv)-0.5;\n float star=1.0-smoothstep(0.015,0.075,length(f)); star*=step(0.974,hash(cell));\n c+=vec3(0.73,0.81,1.0)*star*n*smoothstep(0.03,0.25,h);\n float moon=dot(d,normalize(vec3(-0.08,0.34,-0.94)));\n c=mix(c,vec3(0.82,0.88,0.98),smoothstep(0.99935,0.9995,moon)*n);\n c+=vec3(0.09,0.12,0.18)*pow(max(moon,0.0),120.0)*n;\n COLOR=c;\n}"

