; Engine configuration file.
; Edit with Godot 4.

config_version=5

[application]

config/name="THE FOUR GATES"
run/main_scene="res://look_test/look_test.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="viewport"
window/vsync/vsync_mode=0

[rendering]

renderer/rendering_method="forward_plus"
rendering_device/driver.macos="metal"
rendering_device/fallback_to_opengl3=false
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/use_taa=true
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/positional_shadow/atlas_size=2048
